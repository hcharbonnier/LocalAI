--- a/rocm/ds4_rocm_common.cuh
+++ b/rocm/ds4_rocm_common.cuh
@@ -15,6 +15,21 @@ static int ds4_rocm_is_gfx1151(void) {
     return cached;
 }
 
+/* The raw WMMA builtins only exist on the gfx11 family.  Keep this runtime
+ * check next to the launch sites so gfx9/gfx12 fall back to the generic
+ * shared-input kernel instead of launching a kernel their device image does
+ * not contain. */
+static int ds4_rocm_is_gfx11(void) {
+    static int cached = -1;
+    if (cached >= 0) return cached;
+    int dev = 0;
+    cudaDeviceProp prop;
+    cached = cudaGetDevice(&dev) == cudaSuccess &&
+             cudaGetDeviceProperties(&prop, dev) == cudaSuccess &&
+             strncmp(prop.gcnArchName, "gfx11", 5) == 0;
+    return cached;
+}
+
