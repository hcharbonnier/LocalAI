ARG BASE_IMAGE=ubuntu:24.04
ARG APT_MIRROR=""
ARG APT_PORTS_MIRROR=""

# BASE_IMAGE is either ubuntu:24.04 (for cpu builds), nvidia/cuda:13.0.0-devel-ubuntu24.04
# (for cublas builds) or rocm/dev-ubuntu-24.04:7.2.1 (for hipblas builds). All
# ship apt + Ubuntu Noble packages; the GPU bases additionally provide their
# toolkits. Darwin (Metal) builds bypass this Dockerfile entirely via
# scripts/build/ds4-darwin.sh.
FROM ${BASE_IMAGE} AS builder
ARG BUILD_TYPE
ARG TARGETARCH
ARG TARGETVARIANT
ARG CUDA_MAJOR_VERSION
ARG AMDGPU_TARGETS=""
ARG BUILD_JOBS=4

ENV BUILD_TYPE=${BUILD_TYPE} \
    DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/cuda/bin:/opt/rocm/bin:${PATH}

WORKDIR /build

# Install build-time deps via plain apt - install-base-deps.sh's full pipeline
# (CUDA keyring + from-source gRPC) is unnecessary here:
#   - CUDA: when BASE_IMAGE=nvidia/cuda:*, /usr/local/cuda is already populated;
#     for the cpu build we don't need CUDA at all.
#   - ROCm: the rocm/dev image provides hipcc and the runtime; the -dev packages
#     for rocWMMA/hipCUB/rocBLAS/hipBLASLt are not preinstalled. Use the ROCm
#     repository names (no lib prefix): Ubuntu's libhipcub-dev is HIP 5.7 and
#     overwrites the 7.x headers, breaking hipcc.
#   - gRPC/Protobuf: system apt packages are sufficient; ds4's wrapper only links
#     against them, it doesn't ship the gRPC source tree.
#   - nlohmann-json: dsml_renderer's only third-party dep.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git cmake build-essential pkg-config ca-certificates \
        libgrpc++-dev libprotobuf-dev protobuf-compiler protobuf-compiler-grpc \
        nlohmann-json3-dev && \
    if [ "${BUILD_TYPE}" = "hipblas" ]; then \
        apt-get install -y --no-install-recommends \
            rocwmma-dev hipcub-dev rocblas-dev hipblaslt-dev hipblas-dev; \
    fi && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY . /LocalAI

RUN --mount=type=cache,target=/root/.ccache,id=ds4-ccache-${TARGETARCH}-${BUILD_TYPE},sharing=locked \
    make -j${BUILD_JOBS} -C /LocalAI/backend/cpp/ds4 BUILD_TYPE=${BUILD_TYPE} \
        CUDA_MAJOR_VERSION=${CUDA_MAJOR_VERSION} AMDGPU_TARGETS=${AMDGPU_TARGETS} \
        NATIVE=false grpc-server package

FROM scratch
COPY --from=builder /LocalAI/backend/cpp/ds4/package/. ./
